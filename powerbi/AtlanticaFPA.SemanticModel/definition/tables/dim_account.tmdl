	partition dim_account = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "dim_account.parquet" ) ),
					GroupOrder = [#"Net revenue" = 1, #"Cost of sales" = 2, People = 4, Facilities = 5, IT = 6, Commercial = 7, #"General and admin" = 8, #"D&A" = 10],
					AddedGroupOrder = Table.AddColumn ( Source, "pnl_group_order", each Record.FieldOrDefault ( GroupOrder, [pnl_group], 99 ), Int64.Type )
				in
					AddedGroupOrder

