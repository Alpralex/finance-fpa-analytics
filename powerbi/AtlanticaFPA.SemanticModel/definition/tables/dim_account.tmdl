table dim_account

	column account_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: account_id

	column account_name
		dataType: string
		summarizeBy: none
		sortByColumn: pnl_line_order
		sourceColumn: account_name

	column pnl_group
		dataType: string
		summarizeBy: none
		sortByColumn: pnl_group_order
		sourceColumn: pnl_group

	column pnl_subtotal
		dataType: string
		summarizeBy: none
		sourceColumn: pnl_subtotal

	column pnl_line_order
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: pnl_line_order

	column pnl_group_order
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: pnl_group_order

	column is_revenue
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_revenue

	partition dim_account = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "dim_account.parquet" ) ),
					GroupOrder = [#"Net revenue" = 1, #"Cost of sales" = 2, People = 4, Facilities = 5, IT = 6, Commercial = 7, #"General and admin" = 8, #"D&A" = 10],
					AddedGroupOrder = Table.AddColumn ( Source, "pnl_group_order", each Record.FieldOrDefault ( GroupOrder, [pnl_group], 99 ), Int64.Type )
				in
					AddedGroupOrder
