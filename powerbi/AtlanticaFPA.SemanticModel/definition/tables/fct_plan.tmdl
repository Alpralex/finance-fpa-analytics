table fct_plan

	column scenario
		dataType: string
		summarizeBy: none
		sourceColumn: scenario

	column entity_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: entity_id

	column cost_centre_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: cost_centre_id

	column account_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: account_id

	column product_line_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_line_id

	column month_start
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: month_start

	column amount_lc
		dataType: double
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: amount_lc

	column amount_eur
		dataType: double
		isHidden
		formatString: \€#,0;-\€#,0;\€0
		summarizeBy: sum
		sourceColumn: amount_eur

	column amount_eur_bud_rate
		dataType: double
		isHidden
		formatString: \€#,0;-\€#,0;\€0
		summarizeBy: sum
		sourceColumn: amount_eur_bud_rate

	partition fct_plan = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "fct_plan.parquet" ) )
				in
					Source
