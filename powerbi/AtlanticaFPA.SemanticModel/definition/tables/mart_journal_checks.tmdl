table mart_journal_checks

	column check_type
		dataType: string
		summarizeBy: none
		sourceColumn: check_type

	column entity_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: entity_id

	column account_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: account_id

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month_start

	column vendor
		dataType: string
		summarizeBy: none
		sourceColumn: vendor

	column document_ref
		dataType: string
		summarizeBy: none
		sourceColumn: document_ref

	column postings
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: postings

	column amount_lc
		dataType: double
		formatString: #,0
		summarizeBy: sum
		sourceColumn: amount_lc

	column change_vs_ly
		dataType: double
		formatString: +0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: change_vs_ly

	partition mart_journal_checks = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "mart_journal_checks.parquet" ) )
				in
					Source
