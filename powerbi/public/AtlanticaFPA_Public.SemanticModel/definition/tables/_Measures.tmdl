	/// [Full Year Forecast] for one row of pnl_layout: a P&L group, or a cumulative subtotal (all accounts up to max_line_order).
	measure 'PL Full Year Forecast' =
			VAR _Type = SELECTEDVALUE ( pnl_layout[line_type] )
