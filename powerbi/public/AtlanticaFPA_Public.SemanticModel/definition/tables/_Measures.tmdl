		displayFolder: 3 KPIs
		lineageTag: 99462fcc-9c55-400a-a5fd-f76f54069d74

	/// EBITDA plus depreciation and amortisation.
	measure EBIT = CALCULATE ( [Actual], dim_account[pnl_subtotal] IN { "Gross margin", "EBITDA", "EBIT" } )
		formatString: \€#,0;-\€#,0;\€0
		displayFolder: 3 KPIs
		lineageTag: 4dee787a-cf60-4706-a911-d57d864a2910

	/// [Actual] for one row of pnl_layout: a P&L group, or a cumulative subtotal (all accounts up to max_line_order).
	measure 'PL Actual' =
			VAR _Type = SELECTEDVALUE ( pnl_layout[line_type] )
			VAR _Group = SELECTEDVALUE ( pnl_layout[pnl_group] )
			VAR _MaxOrder = SELECTEDVALUE ( pnl_layout[max_line_order] )
			RETURN
				SWITCH (
					_Type,
					"Group", CALCULATE ( [Actual], dim_account[pnl_group] = _Group ),
					"Subtotal", CALCULATE ( [Actual], dim_account[pnl_line_order] <= _MaxOrder ),
					BLANK ()
				)
		formatString: \€#,0;-\€#,0;\€0
		displayFolder: 4 P&L matrix
		lineageTag: ba3d9caa-3de1-4a27-92f8-7255d281180b

	/// [Budget] for one row of pnl_layout: a P&L group, or a cumulative subtotal (all accounts up to max_line_order).
	measure 'PL Budget' =
			VAR _Type = SELECTEDVALUE ( pnl_layout[line_type] )
			VAR _Group = SELECTEDVALUE ( pnl_layout[pnl_group] )
			VAR _MaxOrder = SELECTEDVALUE ( pnl_layout[max_line_order] )
			RETURN
				SWITCH (
					_Type,
					"Group", CALCULATE ( [Budget], dim_account[pnl_group] = _Group ),
					"Subtotal", CALCULATE ( [Budget], dim_account[pnl_line_order] <= _MaxOrder ),
					BLANK ()
				)
		formatString: \€#,0;-\€#,0;\€0
		displayFolder: 4 P&L matrix
		lineageTag: 80063815-d9bd-4a1b-bbf5-017998b049f7

	/// [Forecast 9+3] for one row of pnl_layout: a P&L group, or a cumulative subtotal (all accounts up to max_line_order).
	measure 'PL Forecast 9+3' =
			VAR _Type = SELECTEDVALUE ( pnl_layout[line_type] )
			VAR _Group = SELECTEDVALUE ( pnl_layout[pnl_group] )
			VAR _MaxOrder = SELECTEDVALUE ( pnl_layout[max_line_order] )
			RETURN
				SWITCH (
					_Type,
					"Group", CALCULATE ( [Forecast 9+3], dim_account[pnl_group] = _Group ),
					"Subtotal", CALCULATE ( [Forecast 9+3], dim_account[pnl_line_order] <= _MaxOrder ),
					BLANK ()
				)
		formatString: \€#,0;-\€#,0;\€0
		displayFolder: 4 P&L matrix
		lineageTag: 0ffc5c7d-4034-430b-b039-2a154cd2e1ca

